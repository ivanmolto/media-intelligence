{
  "name": "media-signal-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "enrich": "tsx --env-file-if-exists=.env scripts/enrich.ts",
    "score": "tsx --env-file-if-exists=.env scripts/score.ts",
    "eval:metrics": "tsx --env-file-if-exists=.env scripts/eval-metrics.ts",
    "eval:export": "tsx --env-file-if-exists=.env scripts/export-evaluation.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env scripts/adversarial-live.ts",
    "init": "npm run migrate && npm run seed && npm run enrich",
    "search:debug": "tsx --env-file-if-exists=.env scripts/search-debug.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{app,lib,components,scripts,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"{app,lib,components,scripts,tests}/**/*.{ts,tsx}\" \"*.{ts,mjs}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "security-audit": "tsx scripts/security-audit.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run security-audit && npm test"
  },
  "dependencies": {
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
